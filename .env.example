# NutriPulse Environment Variables Example

# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES (Vercel Project: fitness-backend or backend/.env)
# ==============================================================================
PORT=5000
NODE_ENV=development
# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/nutripulse?retryWrites=true&w=majority
JWT_SECRET=super_secret_jwt_key_change_in_production_nutripulse_2026
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# FRONTEND ENVIRONMENT VARIABLES (Vercel Project: fitness-frontend or frontend/.env)
# ==============================================================================
VITE_API_URL=http://localhost:5000/api
